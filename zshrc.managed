# Managed by github.com/ushst/my-zsh (do not edit; it may be overwritten).
# Put your changes into ~/.zshrc.local or ~/.zshrc.d/*.zsh

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# --- SSH Latency Optimizations ---
if [[ -n "$SSH_CONNECTION" || -n "$SSH_CLIENT" || -n "$SSH_TTY" ]]; then
    # Disable heavy 'git log' call in 'avit' theme
    function _git_time_since_commit() { }

    # Optimize Oh My Zsh Git status
    zstyle ':omz:alpha:lib:git' fast-untracked-files yes
    export DISABLE_UNTRACKED_FILES_DIRTY="true"

    # Limit zsh-syntax-highlighting length to prevent lag on long commands
    export ZSH_HIGHLIGHT_MAXLENGTH=100

    # Increase zsh-autosuggestions delay
    export ZSH_AUTOSUGGEST_WAIT_CMD_MS=100
fi

# Disable built-in Oh-My-Zsh auto-updater (managed by my-zsh loader in background)
export DISABLE_AUTO_UPDATE="true"
zstyle ':omz:update' mode disabled

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="avit"

# Plugins
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# User configuration
prompt_context() {
  if [[ "$USER" != "$DEFAULT_USER" || -n "$SSH_CLIENT" ]]; then
    prompt_segment black default "%(!.%{%F{yellow}%}.)"
  fi
}

# Lazy-load NVM (Node Version Manager)
if [[ -d "$HOME/.nvm" ]]; then
    export NVM_DIR="$HOME/.nvm"

    _load_nvm() {
        unset -f nvm node npm npx
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    }

    nvm() { _load_nvm; nvm "$@" }
    node() { _load_nvm; node "$@" }
    npx() { _load_nvm; npx "$@" }
    npm() {
        _load_nvm
        if [ "$1" = "s" ]; then
            shift
            command npm start "$@"
        else
            command npm "$@"
        fi
    }
fi

# Custom aliases and functions
alias untargz='tar -xvzf'


function a() {
  local pkg_mgr
  if command -v apt >/dev/null 2>&1; then
    pkg_mgr="apt"
  elif command -v pkg >/dev/null 2>&1; then
    pkg_mgr="pkg"
  else
    echo "No supported package manager (apt/pkg) found."
    return 1
  fi

  local use_sudo=""
  if [[ "$pkg_mgr" == "apt" ]] && command -v sudo >/dev/null 2>&1 && [ "$EUID" -ne 0 ]; then
    use_sudo="sudo"
  fi

  case "$1" in
    i)   shift; $use_sudo $pkg_mgr install "$@" ;;
    u)   $use_sudo $pkg_mgr update ;;
    up)  $use_sudo $pkg_mgr upgrade -y ;;
    all) $use_sudo $pkg_mgr update && $use_sudo $pkg_mgr upgrade -y ;;
    *)   echo "Неизвестная команда: a $1" ;;
  esac
}

extract() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar.bz2|*.tar.gz|*.tar.xz|*.tar) tar xvf "$1" ;;
      *.gz)    gunzip "$1"      ;;
      *.zip)   unzip "$1"       ;;
      *.rar)   unrar x "$1"     ;;
      *.7z)    7z x "$1"        ;;
      *)       echo "Неизвестный формат: $1" ;;
    esac
  else
    echo "Файл не найден: $1"
  fi
}

alias x='extract'

# Create directory and immediately cd into it
mkcd() {
  [[ -n "$1" ]] || { echo "Использование: mkcd <путь_к_папке>"; return 1; }
  mkdir -p -- "$1" && cd -P -- "$1"
}
alias take='mkcd'

# Clone git repository and immediately cd into its directory
gclone() {
  [[ -n "$1" ]] || { echo "Использование: gclone <repo-url> [target-dir] [git options...]"; return 1; }

  local url=""
  local target_dir=""
  local -a args

  for arg in "$@"; do
    if [[ "$arg" =~ ^(https?://|git@|ssh://|git://) ]]; then
      url="$arg"
    fi
    args+=("$arg")
  done

  if [[ -z "$url" ]]; then
    command git clone "$@"
    return $?
  fi

  local last_arg="${args[-1]}"
  if [[ "$last_arg" != "$url" && ! "$last_arg" =~ ^- ]]; then
    target_dir="$last_arg"
  else
    target_dir="$(basename "${url%.git}")"
  fi

  command git clone "$@" && [[ -d "$target_dir" ]] && cd "$target_dir"
}
alias gclcd='gclone'

# Quick FAQ / Help for my-zsh aliases and features
myzsh_faq() {
  cat << 'FAQ_EOF'
=== MY-ZSH CHEAT SHEET / FAQ ===

[ Управление папками и гитом ]
  mkcd <папка> / take <папка>   : Создать папку и сразу перейти в нее
  gclone <url> [папка]           : Клонировать git репозиторий и сразу перейти в него
  gclcd <url>                   : Алиас для gclone

[ Пакетный менеджер ]
  a i <пакет>                   : Установить пакет (apt install / pkg install)
  a u                           : Обновить списки пакетов (apt update)
  a up                          : Обновить установленные пакеты (apt upgrade -y)
  a all                         : Выполнить update + upgrade

[ Распаковка архивов ]
  x <файл> / extract <файл>     : Автоматически распаковать .tar.gz, .zip, .rar, .7z и др.
  untargz <файл>                : Распаковать .tar.gz (tar -xvzf)

[ Управление обновлениями my-zsh ]
  my_zsh_update_check 1         : Принудительно проверить и притянуть обновления с GitHub
  my_zsh_do_update_check        : Выполнить прямое скачивание конфигов
  myzsh-faq / zsh-faq           : Вывести эту справку

[ Пользовательские настройки ]
  Добавляйте свои функции и алиасы в ~/.zshrc.local или ~/.zshrc.d/*.zsh
FAQ_EOF
}
zsh-faq() { myzsh_faq "$@"; }
myzsh-faq() { myzsh_faq "$@"; }
