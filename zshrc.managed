# Managed by github.com/ushst/my-zsh (do not edit; it may be overwritten).
# Put your changes into ~/.zshrc.local or ~/.zshrc.d/*.zsh

# Old installations update only this managed file. Upgrade their entry point once,
# preserving personal additions after the loader's end marker.
_my_zsh_upgrade_legacy_loader() (
  umask 077
  local entry="${ZDOTDIR:-$HOME}/.zshrc"
  local state="${XDG_STATE_HOME:-$HOME/.local/state}/my-zsh"
  local repo="${MyZshUpdaterCfg[repoRawBase]:-https://raw.githubusercontent.com/ushst/my-zsh/main}"
  local work pending lock="$state/loader-migration.lock"
  [[ -f "$entry" && ! -L "$entry" ]] || return 0
  grep -q '^# Keep the entry point stable;' "$entry" && return 0
  [[ "$(head -n 1 "$entry")" == '# --- my-zsh loader + auto-updater (github.com/ushst/my-zsh) ---' ]] || return 0
  grep -q '^# --- end my-zsh loader + auto-updater ---$' "$entry" || return 1
  mkdir -p "$state" || return 1
  # An interrupted migration can leave an empty lock. Downloads are bounded.
  if ! mkdir "$lock" 2>/dev/null; then
    [[ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]] || return 1
    rmdir "$lock" 2>/dev/null && mkdir "$lock" 2>/dev/null || return 1
  fi
  trap '[[ -z "$pending" ]] || rm -f -- "$pending"; rmdir "$lock" 2>/dev/null' EXIT
  work=$(mktemp -d "$state/loader-migration.XXXXXXXX") || return 1
  cp -p "$entry" "$work/zshrc.backup" || return 1
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 5 --max-time 30 "$repo/.zshrc?my_zsh_migrate=$(date +%s)" -o "$work/loader" || return 1
  elif command -v wget >/dev/null 2>&1; then
    wget -q --timeout=10 --tries=1 -O "$work/loader" "$repo/.zshrc?my_zsh_migrate=$(date +%s)" || return 1
  else
    return 1
  fi
  [[ -s "$work/loader" ]] || return 1
  grep -q '^# Keep the entry point stable;' "$work/loader" || return 1
  zsh -n "$work/loader" || return 1
  pending=$(mktemp "${entry}.migration.XXXXXXXX") || return 1
  cat "$work/loader" > "$pending" || return 1
  print >> "$pending"
  awk 'found { print } /^# --- end my-zsh loader \+ auto-updater ---$/ { found=1 }' "$work/zshrc.backup" >> "$pending" || return 1
  zsh -n "$pending" || return 1
  # Do not overwrite edits made while the download was in progress.
  cmp -s "$entry" "$work/zshrc.backup" || return 1
  mv -f "$pending" "$entry"
)

# Network and migration run away from the interactive startup path.
if [[ -o interactive && ${MY_ZSH_AUTOUPDATE:-1} != 0 && -f "${ZDOTDIR:-$HOME}/.zshrc" ]] &&
   ! grep -q '^# Keep the entry point stable;' "${ZDOTDIR:-$HOME}/.zshrc"; then
  ( _my_zsh_upgrade_legacy_loader ) </dev/null >/dev/null 2>&1 &!
fi

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# --- SSH Latency Optimizations ---
if [[ -n "$SSH_CONNECTION" || -n "$SSH_CLIENT" || -n "$SSH_TTY" ]]; then
    # Optimize Oh My Zsh Git status
    export DISABLE_UNTRACKED_FILES_DIRTY="true"

    # Limit zsh-syntax-highlighting length to prevent lag on long commands
    export ZSH_HIGHLIGHT_MAXLENGTH=100

fi

# Disable built-in Oh-My-Zsh auto-updater (managed by my-zsh loader in background)
export DISABLE_AUTO_UPDATE="true"
zstyle ':omz:update' mode disabled

# Path to your oh-my-zsh installation.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"

# Theme
ZSH_THEME="avit"

# Plugins
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 -- "[my-zsh] Oh My Zsh is missing: $ZSH"
fi
# The theme defines this function, so override it after loading the theme.
if [[ -n "$SSH_CONNECTION$SSH_CLIENT$SSH_TTY" ]]; then
  function _git_time_since_commit() { }
fi

# Lazy-load NVM while keeping the npm shortcut available after loading.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    _load_nvm() {
        [[ ${_MY_ZSH_NVM_LOADED:-0} == 1 ]] && return 0
        unset -f nvm node npx
        source "$NVM_DIR/nvm.sh" || return $?
        typeset -g _MY_ZSH_NVM_LOADED=1
    }
    nvm() { _load_nvm && nvm "$@"; }
    node() { _load_nvm && command node "$@"; }
    npx() { _load_nvm && command npx "$@"; }
    npm() {
        _load_nvm || return $?
        if [[ "$1" == s ]]; then
            shift
            command npm start "$@"
        else
            command npm "$@"
        fi
    }
fi

# Custom aliases and functions
alias untargz='tar -xvzf'
alias msf='msfconsole -q'
alias logs='cd /var/log'
alias ports='ss -tuln'
alias myip='ip -br addr'
alias jlog='journalctl -b -e'

# Choose an editable awk template with Alt+A (or Esc, then a).
insert-awk() {
  local choice left right
  zle -R 'AWK: 1 поле | 2 разделитель | 3 фильтр | 4 сумма | 5 последнее поле | 6 строки | 7 число | другая клавиша — отмена' \
    '1  awk '\''{print $1}'\''                         — вывести поле (0 = вся строка)' \
    '2  awk -F '\'':'\'' '\''{print $1}'\''                  — поля разделены двоеточием' \
    '3  awk '\''$1 == "значение" {print $0}'\''          — строки с нужным значением поля' \
    '4  awk '\''{sum += $1} END {print sum}'\''         — сложить значения поля' \
    '5  awk '\''{print $NF}'\''                        — последнее поле строки' \
    '6  awk '\''END {print NR}'\''                     — количество строк' \
    '7  awk '\''$3 > 100'\''                           — числовой фильтр по полю'
  read -r -k 1 choice || { zle -R -c; return 0; }
  case "$choice" in
    1) left="awk '{print \$1"; right="}'" ;;
    2) left="awk -F ':"; right="' '{print \$1}'" ;;
    3) left="awk '\$1 == \""; right="\" {print \$0}'" ;;
    4) left="awk '{sum += \$1"; right="} END {print sum}'" ;;
    5) left="awk '{print \$NF"; right="}'" ;;
    6) left="awk 'END {print NR}'"; right='' ;;
    7) left="awk '\$3 > 100"; right="'" ;;
    *) zle -R -c; return 0 ;;
  esac
  LBUFFER+="$left"
  RBUFFER="$right$RBUFFER"
  zle -R -c
}
zle -N insert-awk
bindkey -M emacs '^[a' insert-awk
bindkey -M viins '^[a' insert-awk


function a() {
  local pkg_mgr
  if [[ -n "$TERMUX_VERSION" || "$PREFIX" == *com.termux* ]] && command -v pkg >/dev/null 2>&1; then
    pkg_mgr="pkg"
  elif command -v apt >/dev/null 2>&1; then
    pkg_mgr="apt"
  elif command -v pkg >/dev/null 2>&1; then
    pkg_mgr="pkg"
  else
    echo "No supported package manager (apt/pkg) found."
    return 1
  fi

  local use_sudo=""
  if [[ "$pkg_mgr" == "apt" ]] && command -v sudo >/dev/null 2>&1 && [ "$EUID" -ne 0 ]; then
    use_sudo="sudo"
  fi

  case "$1" in
    i)   shift; $use_sudo $pkg_mgr install "$@" ;;
    u)   $use_sudo $pkg_mgr update ;;
    up)  $use_sudo $pkg_mgr upgrade -y ;;
    all) $use_sudo $pkg_mgr update && $use_sudo $pkg_mgr upgrade -y ;;
    *)   echo "Неизвестная команда: a $1"; return 1 ;;
  esac
}

extract() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar.bz2|*.tar.gz|*.tar.xz|*.tar) tar xvf "$1" ;;
      *.gz)    gunzip "$1"      ;;
      *.zip)   unzip "$1"       ;;
      *.rar)   unrar x "$1"     ;;
      *.7z)    7z x "$1"        ;;
      *)       echo "Неизвестный формат: $1"; return 1 ;;
    esac
  else
    echo "Файл не найден: $1"
    return 1
  fi
}

alias x='extract'

# Create directory and immediately cd into it
mkcd() {
  [[ -n "$1" ]] || { echo "Использование: mkcd <путь_к_папке>"; return 1; }
  mkdir -p -- "$1" && cd -P -- "$1"
}
alias take='mkcd'

# Clone git repository and immediately cd into its directory
gclone() {
  [[ -n "$1" ]] || { echo "Использование: gclone <author/repo|repo-url|path> [target-dir] [git options...]"; return 1; }

  # Fixed positional interface avoids guessing which option values are paths.
  local url="$1" target_dir name
  # Existing relative paths win; use ./author/repo for explicit local paths.
  if [[ ! -e "$url" && "$url" =~ '^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$' ]]; then
    url="https://github.com/${url%.git}.git"
  fi
  shift
  if (( $# )) && [[ "$1" != -* ]]; then
    target_dir="$1"
    shift
  else
    name="${url%/}"
    name="${name##*/}"
    name="${name##*:}"
    target_dir="${name%.git}"
    [[ " ${*} " == *" --bare "* || " ${*} " == *" --mirror "* ]] && target_dir+='.git'
  fi
  [[ -n "$target_dir" ]] || return 1
  command git clone "$@" -- "$url" "$target_dir" && cd -- "$target_dir"
}
alias gclcd='gclone'

# Quick FAQ / Help for my-zsh aliases and features
myzsh_faq() {
  cat << 'FAQ_EOF'
=== MY-ZSH CHEAT SHEET / FAQ ===

[ Управление папками и гитом ]
  mkcd <папка> / take <папка>   : Создать папку и сразу перейти в нее
  gclone <author/repo|url> [папка] : Клонировать git репозиторий и сразу перейти в него
  gclcd <url>                   : Алиас для gclone

[ Терминал и awk ]
  npm s                        : npm start (при установленном NVM)
  logs                         : Перейти в /var/log
  ports                        : Слушающие TCP/UDP-порты (ss -tuln)
  myip                         : Локальные адреса интерфейсов (ip -br addr)
  jlog [опции]                 : Журнал текущей загрузки (journalctl -b -e)
  l / lsa                      : Файлы, включая скрытые (Oh My Zsh)
  ll                           : Подробный список без скрытых (Oh My Zsh)
  .. / ...                     : Вверх на один / два каталога (Oh My Zsh)
  Ctrl+R                       : Поиск в истории; повторить для следующего совпадения
  msf [аргументы]               : Запустить msfconsole -q (без баннера)
  Alt+A / Esc, затем a         : Меню awk с примерами: 1 поле, 2 разделитель,
                                3 фильтр, 4 сумма, 5 последнее поле, 6 число строк,
                                7 числовой фильтр; другая клавиша — отмена
  Ctrl+E / End                 : В конец команды после редактирования шаблона
  Повторный Alt+A вставляет новый шаблон, а не заменяет предыдущий.

[ Внутри msfconsole — при установленном ~/.msf4/msfconsole.rc ]
  s <запрос>                   : search <запрос>
  so                           : show options
  alias                        : Показать сокращения msfconsole

[ Пакетный менеджер ]
  a i <пакет>                   : Установить пакет (apt install / pkg install)
  a u                           : Обновить списки пакетов (apt update)
  a up                          : Обновить установленные пакеты (apt upgrade -y)
  a all                         : Выполнить update + upgrade

[ Распаковка архивов ]
  x <файл> / extract <файл>     : Автоматически распаковать .tar.gz, .zip, .rar, .7z и др.
  untargz <файл>                : Распаковать .tar.gz (tar -xvzf)

[ Управление обновлениями my-zsh ]
  my_zsh_update_check 1         : Принудительно проверить и притянуть обновления с GitHub
  my_zsh_do_update_check        : Проверить обновления с блокировкой и откатом
  myzsh-faq / zsh-faq           : Вывести эту справку

[ Пользовательские настройки ]
  Добавляйте свои функции и алиасы в ~/.zshrc.local или ~/.zshrc.d/*.zsh
FAQ_EOF
}
zsh-faq() { myzsh_faq "$@"; }
myzsh-faq() { myzsh_faq "$@"; }
